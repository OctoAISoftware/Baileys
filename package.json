{
  "name": "kwhats",
  "type": "module",
  "version": "6.7.24",
  "description": "KWHATS: fork do Baileys com identidade de aparelho canonica (LID<->numero) e guardas de sessao. Ver UPSTREAM.md.",
  "keywords": [
    "whatsapp",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/OctoAISoftware/kwhats.git",
    "directory": "packages/kwhats"
  },
  "license": "MIT",
  "author": "WhiskeySockets (upstream) — fork mantido por OctoAI Software",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "WAProto/**/*",
    "engine-requirements.js",
    "scripts/**/*"
  ],
  "scripts": {
    "build": "node scripts/preparar-build.mjs && tsc -P tsconfig.build.json && tsc-esm-fix --tsconfig=tsconfig.build.json --ext=.js",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest",
    "gen:protobuf": "sh WAProto/GenerateStatics.sh"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "axios": "^1.6.0",
    "kwhats-signal": "*",
    "music-metadata": "^11.7.0",
    "pino": "^9.6",
    "protobufjs": "^7.2.4",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^16.0.0",
    "@types/ws": "^8.0.0",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.0",
    "tsc-esm-fix": "3.1.2",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "audio-decode": "^2.1.3",
    "jimp": "^1.6.0",
    "link-preview-js": "^3.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
